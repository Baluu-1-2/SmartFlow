# ==============================================================================
# SmartFlow — AI-Powered Smart To-Do Application Environment Variables
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Frontend Origin for CORS
CLIENT_URL=http://localhost:5173

# Database Connection
# Option 1: Managed PostgreSQL (Supabase, Neon, AWS RDS, Render Postgres)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Option 2: Leave blank for zero-config embedded PostgreSQL (PGlite) fallback
# DATABASE_URL=

# JSON Web Token Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# Google Gemini AI Integration (Optional)
# Get a free key at: https://aistudio.google.com/
# If omitted or invalid, SmartFlow seamlessly activates its smart heuristics engine!
GEMINI_API_KEY=
